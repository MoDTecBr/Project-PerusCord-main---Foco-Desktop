# Copie este arquivo para .env e preencha os valores antes de rodar `npm run dev`.
# NUNCA commite o .env real — ele já está no .gitignore.

NODE_ENV=development
PORT=3000
# Inclua a porta do `flutter run -d chrome/edge/web-server` — o navegador
# bloqueia silenciosamente (CORS) qualquer origem que não estiver aqui.
CORS_ORIGINS=http://localhost:3000,http://localhost:5050

# Postgres — credenciais batem com infra/docker/docker-compose.yml para dev local.
DATABASE_URL=postgresql://relay:relay_dev_password@localhost:5432/relay

# Redis — cache, presença, rate limiting e filas.
REDIS_URL=redis://localhost:6379

# Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=troque-por-um-segredo-de-pelo-menos-32-caracteres
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Gere com: openssl rand -base64 32 — usado para criptografar o segredo TOTP em repouso.
MFA_ENCRYPTION_KEY=troque-por-um-segredo-de-pelo-menos-32-caracteres

# Custo do Argon2id — os defaults abaixo já são um ponto de partida razoável.
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

AUTH_RATE_LIMIT_TTL_SECONDS=60
AUTH_RATE_LIMIT_MAX=10

# MinIO (S3-compatível) — dev local via infra/docker/docker-compose.yml.
S3_ENDPOINT=http://localhost:9000
# URL usada dentro do link devolvido ao cliente — troque pelo IP do Radmin
# VPN (ou domínio público) se for além de localhost, senão só quem está
# nesta máquina consegue abrir os arquivos enviados.
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=relay
S3_SECRET_KEY=relay_dev_password
S3_BUCKET=relay-uploads

# LiveKit (Fase 5 — voz/vídeo/tela). O valor de LIVEKIT_API_SECRET aqui é só
# um placeholder — gere o seu com `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# e use o MESMO valor em infra/docker/livekit.yaml (o servidor LiveKit exige
# pelo menos 32 caracteres). Nunca reaproveite uma chave de dev em produção.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=troque-por-um-segredo-de-pelo-menos-32-caracteres
