# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
# dist/
dist-portable/
build/
*.tsbuildinfo
.turbo/

# Environment / secrets — never commit real values
.env
.env.*
!.env.example

# Prisma
apps/api/prisma/migrations/dev/

# Logs
logs/
*.log
npm-debug.log*

# Test / coverage
coverage/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Docker volumes (local dev data)
infra/docker/.data/

# Arquivos publicados pelo desktop_updater (auto-update do app desktop) —
# grandes demais e regeneráveis via `dart run desktop_updater:release publish`
apps/api/releases/

# Chave privada de assinatura de release do desktop_updater — NUNCA commitar
*.dukey

# Flutter / Dart (apps/client)
apps/client/.dart_tool/
apps/client/.flutter-plugins
apps/client/.flutter-plugins-dependencies
apps/client/.packages
apps/client/build/
apps/client/android/local.properties
apps/client/ios/Flutter/.last_build_id
apps/client/**/*.g.dart
*.iml
